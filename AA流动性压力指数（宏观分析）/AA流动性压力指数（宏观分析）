    // 【V66 新增】三阶补入短端一级市场定价(Bill-OIS)：V64 起资金去向结构改为三渠道恒等式后，
    // 3M T-Bill 相对 SOFR 的溢价/折价才是"微观定价层"里对短债供需最直接的报价证据，与二阶的水位判定形成闭环。
    string l3_bill = not use_v62 ? "" : na(v62_bill_ois) ? " [短端定价] 3M T-Bill 相对 SOFR 数据缺失，短债供需无法定量判定；" : v62_bill_hot ? " 🎯【短端定价扭曲】3M T-Bill 收益率低于 SOFR " + str.tostring(math.abs(v62_bill_ois), "#.#") + "BP(Bill-OIS 深度负溢价)，一级市场短债被抢筹至溢价成交，货基正用现金替财政融资，属" + (v62_net_drain_on ? "抽水行情下的被动承接，短端收益率被人为压低；" : v62_net_drain < -v62_net_drain_th ? "放水行情下货基仍抢短债，说明资金停在短端、未外溢至风险资产；" : "典型的避险资金涌入短端，风险资产相对吸引力下降；") : v62_bill_ois > 20 ? " ⚠【短端供给压力】3M T-Bill 高于 SOFR " + str.tostring(v62_bill_ois, "#.#") + "BP，一级市场短债供给堆积、须抬高收益率才能出清，财政融资正在分流短端资金；" : " [短端定价常态] Bill-OIS 为" + str.tostring(v62_bill_ois, "#.#") + "BP，短债一级市场供需未见极端挤压；"
    string ai_level_3_raw = "【三阶微观定价与风险溢价】" + l3_curve + l3_credit + l3_breadth + l3_bill
    
    // 【V73-B方案】四段合流：原实现四段各自独立 f_auto_wrap，每段末行必然不满一行(4 处段尾留白)，
    // 且段间 "\n\n" 硬插 3 个空行。现用 " ｜ " 把四段原始串串成一条流、段标签【一阶…】内嵌其中，
    // 只做一次换行：段尾留白 4 处 -> 1 处(仅全篇末尾)，空行 3 个 -> 0 个；
    // "｜" 属分隔符集，断行优先落在段标签前，段首视觉上仍整齐。
    // v73_ai_stream=false 时完整回退 V72 的四段独立换行 + 段间空行。
    string ai_stream_raw = flow_analysis_raw + " ｜ " + ai_level_1_raw + " ｜ " + ai_level_2_raw + " ｜ " + ai_level_3_raw
    string ai_judgment = ""
    if v73_ai_stream
        ai_judgment := f_auto_wrap(ai_stream_raw, v69_w_ai)
    else
        ai_judgment := f_auto_wrap(flow_analysis_raw, v69_w_ai) + "\n\n" + f_auto_wrap(ai_level_1_raw, v69_w_ai) + "\n\n" + f_auto_wrap(ai_level_2_raw, v69_w_ai) + "\n\n" + f_auto_wrap(ai_level_3_raw, v69_w_ai)
    
    table.cell(us_table, 0, 0, "LSI 压力", text_color=#ffffff, text_size=table_size, bgcolor=color.new(#333333, 50))
    table.cell(us_table, 1, 0, lsi_data_ok ? str.tostring(lsi, "#.##") + " BP" : "N/A", text_color=not lsi_data_ok ? color.gray : lsi >= threshold_extreme_tight ? color.maroon : lsi >= threshold_tight ? color.red : lsi < 0 ? color.green : #ffffff, text_size=table_size)
    table.cell(us_table, 2, 0, "GLI / 储备", text_color=#ffffff, text_size=table_size, bgcolor=color.new(#333333, 50))
    table.cell(us_table, 3, 0, str.tostring(total_liq, "#.##") + " / " + (na(reserves_trillion) ? "N/A" : str.tostring(reserves_trillion, "#.##") + "T"), text_color=is_gli_loose ? color.lime : is_gli_tight ? color.rgb(148, 147, 235, 9) : color.white, text_size=table_size)
    table.cell(us_table, 4, 0, "RRP 余额", text_color=#ffffff, text_size=table_size, bgcolor=color.new(#333333, 50))
    table.cell(us_table, 5, 0, rrp_data_ok ? rrp_bal_txt + " (" + (na(rrp_pct) ? "N/A" : str.tostring(rrp_pct, "#.###") + "%") + ")" : "N/A", text_color=not rrp_data_ok ? color.gray : is_rrp_exhausted ? color.red : color.lime, text_size=table_size)
    table.cell(us_table, 6, 0, "US02Y/利差", text_color=#ffffff, text_size=table_size, bgcolor=color.new(#333333, 50))
    table.cell(us_table, 7, 0, str.tostring(us02y_val, "#.##") + " / " + str.tostring(math.abs(us02y_val - effr_val), "#.##"), text_color = us02y_val > effr_val ? color.red : color.green, text_size = table_size)

    table.cell(us_table, 0, 1, "SOFR/RRP", text_color=#ffffff, text_size=table_size, bgcolor=color.new(#333333, 50))
    table.cell(us_table, 1, 1, str.tostring(sofr/100, "#.##") + " / " + str.tostring(rrp_rate/100, "#.##"), text_color=(sofr - rrp_rate < 0 ? color.green : sofr - rrp_rate > 20 ? color.red : #ffffff), text_size=table_size)
    table.cell(us_table, 2, 1, "EFFR/IORB", text_color=#ffffff, text_size=table_size, bgcolor=color.new(#333333, 50))
    table.cell(us_table, 3, 1, str.tostring(effr_val, "#.##") + " / " + str.tostring(iorb/100, "#.##"), text_color=(not lsi_data_ok ? color.gray : effr - iorb < -5 ? color.green : effr - iorb > -2 ? color.red : color.orange), text_size=table_size)
    table.cell(us_table, 4, 1, "通胀预/实", text_color=#ffffff, text_size=table_size, bgcolor=color.new(#333333, 50))
    table.cell(us_table, 5, 1, str.tostring(t10yie_val, "#.##") + "% / " + str.tostring(real_rate_val, "#.##") + "%", text_color=(t10yie_val > th_t10yie or real_rate_val > th_real_tight ? color.red : color.white), text_size=table_size)
    table.cell(us_table, 6, 1, "信用/通胀", text_color=#ffffff, text_size=table_size, bgcolor=color.new(#333333, 50))
  
    table.cell(us_table, 7, 1, str.tostring(credit_val, "#.##") + "%" + credit_roc_str + " / " + str.tostring(inf_yoy_val, "#.##") + "%", text_color=(credit_val > (credit_th/100) or inf_yoy_val > th_inf_yoy or is_credit_spiking ? color.red : color.white), text_size=table_size)

    // ---- 行2: 冲量 / 广度 / 曲线斜率预警(V66: 去 10Y-2Y 独立格, 并让 3 格给预警串) ----
    table.cell(us_table, 0, 2, "流动性冲量", text_color=#ffffff, text_size=table_size, bgcolor=color.new(#333333, 50))
    table.cell(us_table, 1, 2, str.tostring(liq_impulse, "#.##") + "%" + (is_impulse_waning ? " ⚠" : ""), text_color = liq_impulse > 0 ? color.lime : color.orange, text_size = table_size)
    table.cell(us_table, 2, 2, "S5TH 广度", text_color=#ffffff, text_size=table_size, bgcolor=color.new(#333333, 50))
    table.cell(us_table, 3, 2, str.tostring(s5th_raw, "#.#") + "%", text_color = is_s5th_severe ? color.red : is_s5th_weak_condition ? color.orange : color.white, text_size=table_size)
    // V66: 10Y-2Y 独立显示格已移除(用户不使用), 利差数值并入曲线预警串, 腾出的宽度给预警文案
    table.cell(us_table, 4, 2, "曲线/斜率预警", text_color=#ffffff, text_size=table_size, bgcolor=color.new(#333333, 50))
    table.merge_cells(us_table, 5, 2, 7, 2)
    table.cell(us_table, 5, 2, curve_status_compact, text_color=curve_status_color, text_size=table_size, text_halign=text.align_left)

    // ---- 行3: 资金去向(周) 整行优先权，容纳 V64 短端雷达 ----
    table.merge_cells(us_table, 0, 3, 1, 3)
    table.cell(us_table, 0, 3, "🩸资金去向(周)", text_color=#ffffff, text_size=table_size, bgcolor=color.new(#333333, 50))
    table.merge_cells(us_table, 2, 3, 7, 3)
    table.cell(us_table, 2, 3, v62_flow_wrapped, text_color=v62_flow_color, text_size=table_size, text_halign=text.align_left, text_valign=text.align_center)

    // ---- 行4: 宏观状态 ----
    table.merge_cells(us_table, 0, 4, 7, 4)
    table.cell(us_table, 0, 4, final_text, text_color = urgent_alert ? color.rgb(255, 140, 0) : color.white, text_size=table_size, text_halign=text.align_left, text_valign=text.align_center)

    // ---- 行5: AI 四维 ----
    table.merge_cells(us_table, 0, 5, 7, 5)
    table.cell(us_table, 0, 5, ai_judgment, text_color = color.rgb(190, 234, 255), text_size=table_size, text_halign=text.align_left, text_valign=text.align_center)
