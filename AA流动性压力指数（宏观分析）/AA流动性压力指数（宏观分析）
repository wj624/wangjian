// 【V69 B方案】换行重构（V72 升级为「视觉列」口径）
//   V69 已解决"末块永远填不满 / 数字串被拦腰切断"：贪心装填 + 从硬切点向前回退、优先落在语义分隔符上。
//   V72 修的是度量单位——原按 str.length() 字符数计宽，而中文/全角标点/emoji 的显示宽度约为 ASCII 的 2 倍，
//   110「字符」的混排行实际占 170~190 视觉列，单行把看板撑到约 1100px 并向左压掉 K 线区。
//   现改为按显示宽度累加：ASCII 可打印字符 1 列、其余(中文/全角/emoji) 2 列；装满 max_cols 才断行，
//   回退落点仍优先语义分隔符(｜；。，、空格 括号 斜杠 冒号 加号)。行尾无留白，数字与词组不被切断。
//   v72_width_aware=false 时整体回退 V69 的字符计数实现(f_wrap_legacy)。
//   V73 只改一处：回退容差由写死的 mc/2 改为 mc/v73_back_div。原 mc/2 让每行最多可少填半行，
//   遇「；、）」即提前断行，是"右侧空很大"的主因；V74 起默认 1/10(≈13 列)，填充率稳定在 90% 以上。
f_wrap_legacy(txt, max_chars) =>
    string result = ""
    int total = str.length(txt)
    int mc = max_chars > 20 ? max_chars : 20
    if total <= mc
        result := txt
    else
        string seps = "｜；。，、 ）】」/·"
        int pos = 0
        for k = 0 to 79
            if pos < total
                if total - pos <= mc
                    result += str.substring(txt, pos, total)
                    pos := total
                else
                    int cut = math.min(pos + mc, total)
                    int back = -1
                    int limit = int(math.floor(mc / 3.0))
                    for j = 0 to limit
                        int cand = cut - j
                        if cand > pos + 1 and cand <= total and back < 0
                            if str.contains(seps, str.substring(txt, cand - 1, cand))
                                back := j
                    int real_cut = back >= 0 ? cut - back : cut
                    result += str.substring(txt, pos, real_cut) + "\n"
                    pos := real_cut
        if pos < total
            result += str.substring(txt, pos, total)
    result

// V72 宽度感知换行：ASCII 可打印字符计 1 列，中文/全角/emoji 计 2 列
f_wrap_w(txt, max_cols) =>
    int total = str.length(txt)
    int mc = max_cols > 24 ? max_cols : 24
    // V73-A1: 回退容差从 mc/2 收窄为 mc/v73_back_div(V74 起默认 10)，强制每行填充率 ≥90%
    int back_max = int(math.floor(mc / (v73_back_div > 1.0 ? v73_back_div : 2.0)))
    string ascii_set = " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"
    string seps = "｜；。，、 ）】」/·+:"
    string res = ""
    int pos = 0
    int lines = 0
    if total > 0
        while pos < total and lines < 40
            int i = pos
            int w = 0
            int sep_at = -1
            while i < total and w <= mc
                string ch = str.substring(txt, i, i + 1)
                int cw = str.contains(ascii_set, ch) ? 1 : 2
                if w + cw > mc
                    w := mc + 1
                else
                    w := w + cw
                    if str.contains(seps, ch)
                        sep_at := i
                    i := i + 1
            int cut = i
            if i >= total
                res := res + str.substring(txt, pos, total)
                pos := total
            else
                if sep_at >= pos + 1 and (i - sep_at) <= back_max
                    cut := sep_at + 1
                if cut <= pos
                    cut := pos + 1
                res := res + str.substring(txt, pos, cut) + "\n"
                pos := cut
            lines := lines + 1
        // 【V81 FIX-P3】行数硬上限触发时, 余下全文并入末行, 绝不静默丢弃尾部文本
        if pos < total
            res := res + str.substring(txt, pos, total)
            pos := total
    res

// 统一入口：按开关选择口径，函数签名与全部调用点保持不变
f_auto_wrap(txt, max_cols) =>
    string outp = v72_width_aware ? f_wrap_w(txt, max_cols) : f_wrap_legacy(txt, max_cols)
    outp

// 【V80 A】curve_warn_text / curve_status_compact 已移入末尾渲染块(仅末根 bar 构建)；
//   原"资金去向整行较长, 主动换行避免被裁切"的构建也随之迁移。
