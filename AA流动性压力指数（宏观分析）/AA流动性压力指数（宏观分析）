// === 2. 最高稳定性统一请求函数 (已为了V57极速性能重构，解除嵌套节省算力) ===

// === 3. 数据符号定义 ===
s_fed   = "ECONOMICS:USCBBS"
s_ecb   = "ECONOMICS:EUCBBS"
s_pbc   = "ECONOMICS:CNCBBS"
s_boj   = "ECONOMICS:JPCBBS"
s_eurusd = "FX_IDC:EURUSD"
s_cnyusd = "FX_IDC:CNYUSD"
s_jpyusd = "FX_IDC:JPYUSD"
s_tga   = "FRED:WTREGEN"
s_rrp_b = "FRED:RRPONTSYD"
src_WRBWFRBL = "FRED:WRBWFRBL"
src_TLAACBM027SBOG = "FRED:TLAACBM027SBOG"
src_GDP = "FRED:GDP"

// === 4. 数据请求 (V61极速版：扁平化直接请求，严格控制在28次请求以内，彻底杜绝RE10137超限报错) ===
raw_fed = request.security(s_fed, "D", close, gaps=barmerge.gaps_off, ignore_invalid_symbol=true)
raw_ecb = request.security(s_ecb, "D", close, gaps=barmerge.gaps_off, ignore_invalid_symbol=true)
raw_pbc = request.security(s_pbc, "D", close, gaps=barmerge.gaps_off, ignore_invalid_symbol=true)
raw_boj = request.security(s_boj, "D", close, gaps=barmerge.gaps_off, ignore_invalid_symbol=true)

raw_eurusd = request.security(s_eurusd, "D", close, gaps=barmerge.gaps_off, ignore_invalid_symbol=true)
raw_cnyusd = request.security(s_cnyusd, "D", close, gaps=barmerge.gaps_off, ignore_invalid_symbol=true)
raw_jpyusd = request.security(s_jpyusd, "D", close, gaps=barmerge.gaps_off, ignore_invalid_symbol=true)

raw_tga = request.security(s_tga, "D", close, gaps=barmerge.gaps_off, ignore_invalid_symbol=true)
raw_rrp_b = request.security(s_rrp_b, "D", close, gaps=barmerge.gaps_off, ignore_invalid_symbol=true)

fed_bal      = use_fed  ? nz(raw_fed) : 0.0
ecb_bal_raw  = use_ecb  ? nz(raw_ecb) : 0.0
pbc_bal_raw  = use_pbc  ? nz(raw_pbc) : 0.0
boj_bal_raw  = use_boj  ? nz(raw_boj) : 0.0

eur_usd = use_ecb ? nz(raw_eurusd, nz(raw_eurusd[1], 1.196)) : 1.0
cny_usd = use_pbc ? nz(raw_cnyusd, nz(raw_cnyusd[1], 0.144)) : 1.0
jpy_usd = use_boj ? nz(raw_jpyusd, nz(raw_jpyusd[1], 0.00652)) : 1.0

tga_bal = use_tga ? nz(raw_tga) : 0.0
rrp_bal = use_rrp ? nz(raw_rrp_b) : 0.0

reserves_raw_display = request.security("FRED:WRESBAL", "D", close, gaps=barmerge.gaps_off, ignore_invalid_symbol=true)
wr_bal_raw_display   = request.security(src_WRBWFRBL, "D", close, gaps=barmerge.gaps_off, ignore_invalid_symbol=true)
total_assets_display = request.security(src_TLAACBM027SBOG, "D", close, gaps=barmerge.gaps_off, ignore_invalid_symbol=true)
gdp_raw              = request.security(src_GDP, "D", close, gaps=barmerge.gaps_off, ignore_invalid_symbol=true)

s5th_raw     = request.security(s5th_symbol, "D", close, gaps=barmerge.gaps_off, ignore_invalid_symbol=true)
gold_price   = request.security("TVC:GOLD", "D", close, gaps=barmerge.gaps_off, ignore_invalid_symbol=true)
silver_price = request.security("TVC:SILVER", "D", close, gaps=barmerge.gaps_off, ignore_invalid_symbol=true)

wdtgal   = request.security("FRED:WDTGAL", "D", close, gaps=barmerge.gaps_off, ignore_invalid_symbol=true)
wrbwfrbl = wr_bal_raw_display
[dxy_raw, dxy_ma] = request.security(src_dxy, "D", [close, ta.sma(close, dxy_ma_len)], gaps=barmerge.gaps_off, ignore_invalid_symbol=true)

wlrr = request.security("FRED:WLRRAL", "D", close, gaps=barmerge.gaps_off, ignore_invalid_symbol=true)

// 【BUG修复】使用 raw_rrp_b 独立计算逆回购流向，并在 nz 中传入当前值防止首根K线空值引发千亿级假抽水
delta_tga_b  = (wdtgal - nz(wdtgal[flow_lookback], wdtgal)) / 1000000000 
delta_wlrr_b = (wlrr - nz(wlrr[flow_lookback], wlrr)) / 1000000000
delta_rrp_b  = (raw_rrp_b - nz(raw_rrp_b[flow_lookback], raw_rrp_b)) / 1000000000

max_drain = math.max(delta_tga_b, math.max(delta_wlrr_b, delta_rrp_b))
min_inject = math.min(delta_tga_b, math.min(delta_wlrr_b, delta_rrp_b))

// 【V80 A】drain_name / inject_name 已移入末尾渲染块(仅末根 bar 构建)；max_drain / min_inject 仍为全局数值。

// 【V75 修复 P3-11】清理死变量：drain_str / inject_str / fed_flow_str / flow_text_color 声明后零引用；
//   其独占依赖 is_core_draining / is_core_injecting 一并移除。drain_name / inject_name / max_drain / min_inject
//   仍被 flow_legacy(V57 回退口径) 使用，全部保留。

// === 5. 核心计算 ===
total_liq = (fed_bal - tga_bal - rrp_bal + (ecb_bal_raw * eur_usd) + (pbc_bal_raw * cny_usd) + (boj_bal_raw * jpy_usd)) / 1000000000000
prev_liq = nz(total_liq[gli_mom_lookback], total_liq)
denom = math.max(math.abs(prev_liq), 0.01)

// 【逻辑修复】流动性冲量计算：引入 nz 强制过滤历史空值污染
total_liq_change = (total_liq - prev_liq) / denom * 100
liq_impulse = nz(total_liq_change) - nz(total_liq_change[gli_mom_lookback])

// 【V75 修复 P2-8】量级防呆：若数据源口径由"美元"改为"百万/十亿"，除数自适应；
//   正常美元口径(>1e10)走 1e12 分支，数值与旧版完全一致，不改变任何历史判定。
float reserves_scale = na(reserves_raw_display) ? 1000000000000.0 : reserves_raw_display > 10000000000.0 ? 1000000000000.0 : reserves_raw_display > 10000000.0 ? 1000000000.0 : reserves_raw_display > 10000.0 ? 1000000.0 : 1000.0
reserves_trillion = reserves_raw_display / reserves_scale
// 【BUG修复】TradingView 已将 FRED:GDP 与 FRED:WRBWFRBL 还原为原始美元；若 gdp_raw > 1e11 直接对齐，避免乘以 1000 把 GDP 放大千倍导致准备金/GDP 恒小于 11%
float gdp_aligned = gdp_raw > 1e11 ? gdp_raw : gdp_raw * 1000

reserve_to_gdp_ratio = wr_bal_raw_display / (gdp_aligned > 0 ? gdp_aligned : na)
reserve_to_assets_ratio = wr_bal_raw_display / (total_assets_display > 0 ? total_assets_display : na)
is_reserve_low_gdp = reserve_to_gdp_ratio < reserve_gdp_threshold and not na(reserve_to_gdp_ratio)
is_reserve_low_assets = reserve_to_assets_ratio < reserve_assets_threshold and not na(reserve_to_assets_ratio)
is_reserve_insufficient = is_reserve_low_gdp and is_reserve_low_assets

// 【V75 修复 P0-2】保留 raw 值用于"数据是否真实存在"判定：原实现四个分量各自 nz() 兜 0，
//   RRP 利率源失效时 rrp_rate=0，lsi 虚增约 390BP，直接击穿 50BP 极端紧张阈值并误报"管道破裂/休克危机"。
//   现 nz 仅用于数值兜底(下游大量算式依赖)，另立 lsi_data_ok 统一 gate 所有 LSI 判定与文案。
float sofr_raw = request.security(src_sofr, "D", close, gaps=barmerge.gaps_off, ignore_invalid_symbol=true)
float rrp_rate_raw = request.security(src_rrp, "D", close, gaps=barmerge.gaps_off, ignore_invalid_symbol=true)
float effr_raw = request.security(src_effr, "D", close, gaps=barmerge.gaps_off, ignore_invalid_symbol=true)
float iorb_raw = request.security(src_iorb, "D", close, gaps=barmerge.gaps_off, ignore_invalid_symbol=true)
sofr = nz(sofr_raw * 100)
rrp_rate = nz(rrp_rate_raw * 100)
effr = nz(effr_raw * 100)
iorb = nz(iorb_raw * 100)
us02y = nz(request.security(src_us02y, "D", close, gaps=barmerge.gaps_off, ignore_invalid_symbol=true) * 100)
us10y = nz(request.security(src_us10y, "D", close, gaps=barmerge.gaps_off, ignore_invalid_symbol=true) * 100) 
t10yie = nz(request.security(src_t10yie, "D", close, gaps=barmerge.gaps_off, ignore_invalid_symbol=true) * 100)
dfii10 = nz(request.security(src_dfii10, "D", close, gaps=barmerge.gaps_off, ignore_invalid_symbol=true) * 100)
credit_spread = nz(request.security(src_credit_spread, "D", close, gaps=barmerge.gaps_off, ignore_invalid_symbol=true) * 100)
us_inflation_rate = nz(request.security(src_usiryy, "D", close, gaps=barmerge.gaps_off, ignore_invalid_symbol=true) * 100)

// --- [优化模块] 收益率曲线斜率 (牛陡/熊陡) 监控 (危机捕获版) ---
yield_spread = us10y - us02y

smooth_us10y = ta.sma(us10y, 3)
smooth_us02y = ta.sma(us02y, 3)
smooth_spread = ta.sma(yield_spread, 3)

us10y_change = smooth_us10y - nz(smooth_us10y[curve_lookback], smooth_us10y)
us02y_change = smooth_us02y - nz(smooth_us02y[curve_lookback], smooth_us02y)
spread_change = smooth_spread - nz(smooth_spread[curve_lookback], smooth_spread)

bool curve_data_valid = not na(smooth_us10y[curve_lookback]) and not na(smooth_us02y[curve_lookback])

is_bull_steepener = curve_data_valid and (spread_change > spread_change_th) and (us02y_change <= -us02y_drop_th)
is_bear_steepener = curve_data_valid and (spread_change > spread_change_th) and (us10y_change >= us10y_spike_th)
var string curve_status_text = "平稳"
var color curve_status_color = color.gray

if is_bull_steepener
    curve_status_text := "牛陡(衰退前兆)"
    curve_status_color := color.red
else if is_bear_steepener
    curve_status_text := "熊陡(杀估值)"
    curve_status_color := color.orange
else if yield_spread < -50
    curve_status_text := "深度倒挂"
    curve_status_color := color.yellow
else if yield_spread < 0
    curve_status_text := "浅度倒挂"
    curve_status_color := color.gray
else
    curve_status_text := "平稳正斜率"
    curve_status_color := color.green
// -------------------------------------------------------------------------

credit_spread_roc = ta.roc(credit_spread, credit_roc_len)
is_credit_spiking = use_credit_roc and not na(credit_spread_roc) and (credit_spread_roc > credit_roc_th)
is_dxy_strong = not na(dxy_raw) and not na(dxy_ma) and (dxy_raw > dxy_ma)

s5th_ma5  = ta.sma(s5th_raw, 5)
s5th_ma20 = ta.sma(s5th_raw, 20)
s5th_ma50 = ta.sma(s5th_raw, 50)
is_s5th_weak = not na(s5th_raw) and s5th_raw < s5th_weak_th
is_s5th_death_cross = not na(s5th_ma5) and not na(s5th_ma20) and not na(s5th_ma50) and s5th_ma5 < s5th_ma20 and s5th_ma20 < s5th_ma50
is_s5th_weak_condition = use_s5th_alert and (is_s5th_weak and is_s5th_death_cross)
is_s5th_severe = use_s5th_alert and not na(s5th_raw) and s5th_raw < s5th_severe_th
is_s5th_overheat = use_s5th_alert and not na(s5th_raw) and s5th_raw >= s5th_overheat_th
is_s5th_bottom = use_s5th_alert and not na(s5th_raw) and s5th_raw <= s5th_bottom_th

gs_ratio_raw = (not na(silver_price) and silver_price != 0) ? gold_price / silver_price : na
gs_ratio     = nz(gs_ratio_raw, nz(gs_ratio_raw[1], na))
is_gs_low    = use_gsr_alert and not na(gs_ratio) and gs_ratio <= gsr_low_threshold
is_gs_high   = use_gsr_alert and not na(gs_ratio) and gs_ratio >= gsr_high_threshold

// 保持 59 版美联储救市扩表脉冲见顶设计逻辑 (TGA + 准备金同步暴涨后放缓跌破均线)
lookback_norm = 500
wdtgal_min = ta.lowest(wdtgal, lookback_norm)
wdtgal_max = ta.highest(wdtgal, lookback_norm)
wrb_min = ta.lowest(wrbwfrbl, lookback_norm)
wrb_max = ta.highest(wrbwfrbl, lookback_norm)
norm_wdtgal = (wdtgal - wdtgal_min) / math.max(wdtgal_max - wdtgal_min, 1e-6)
norm_wrb = (wrbwfrbl - wrb_min) / math.max(wrb_max - wrb_min, 1e-6)
fed_liq_proxy = norm_wdtgal * 0.5 + norm_wrb * 0.5
ma_fed_liq = ta.sma(fed_liq_proxy, ma_period)
fed_liq_top = fed_liq_proxy < ma_fed_liq and not na(ma_fed_liq)

gold_top_diff = effr - us_inflation_rate
is_gold_top = gold_top_diff < gold_th
is_impulse_waning = ta.falling(liq_impulse, 3)

// 【BUG修复】使用 raw_rrp_b 计算，防止用户关闭 GLI 的 use_rrp 开关时误触发 RRP 枯竭
// 【V75 修复 P0-1】数据源失活保护：原实现 nz(raw_rrp_b,0) 会把"取不到数据"伪装成"余额=0"，
//   导致 is_rrp_exhausted = (pct<5 or 余额<0.1) 恒真，看板长期误报"RRP 枯竭至 0.000T、峰值占比 0.0%"，
//   并连带污染 is_liquidity_break / urgent_alert。现改为 na 传播 + 显式数据有效性布尔。
bool  rrp_data_ok  = not na(raw_rrp_b)
// 【V78 撤销 V77 FIX-2 量级自适应】自适应判定(raw>1e10 ? 1e12 : 1000)是错误设计：
//   TV 对 FRED:RRPONTSYD 稳定返回美元原值(现值约 2.5e9)，恰低于 1e10 阈值，被误判成"十亿美元口径"
//   而除以 1000，余额虚增 1e9 倍，面板显示成 25000000 千亿；且历史各 bar 可能走不同分支，
//   使 rrp_trillion(cur) 与 rrp_peak 量纲不一致，连带污染 rrp_pct。
//   现退回 V76 的固定确定换算，不做任何量级猜测：T = 美元原值 / 1e12。
float rrp_trillion = rrp_data_ok ? raw_rrp_b / 1000000000000.0 : float(na)
// 【V77 FIX-1 保留】千亿口径(1e11)：0.1T = 1 千亿，故除 1e11(与 T 口径严格 10 倍关系)。
float rrp_100b     = rrp_data_ok ? raw_rrp_b / 100000000000.0 : float(na)
// 【V79 FIX-5】余额显示单位自适应：RRP 已接近归零，千亿口径下读数落在 0.00xx(如 0.0025 千亿 = 2.5 亿美元)，
//   量级读不出来。现按量级切换单位：余额 >= 1 千亿显示"千亿"(如 25.54千亿)，< 1 千亿显示"亿"(如 2.5亿)。
//   1 千亿 = 1000 亿，故亿 = rrp_100b * 1000。仅改显示文本，rrp_trillion / rrp_pct / 全部判据一律不动。
// 【V80 A】rrp_bal_txt 已移入末尾渲染块(仅末根 bar 构建)，单位自适应口径原样保留。
// 【V75 修复 P1-2.2】峰值回看窗口 500 -> 2500 bar：RRP 峰值 2.5T 出现在 2022-2023，500 bar(约2年)窗口
//   内只剩 0.2T 级别，导致"占峰值 <5%"的相对判据永久失效，只剩 0.1T 绝对兜底。2500 bar(约10年)
//   才能覆盖 2022 峰值与 2019/2014 旧高位。
// 【V77 FIX-3】bar 数不足 2500 时 ta.highest 返回 na，会让 rrp_pct 整体失效并被 nz(...,100) 静默
//   判为"不枯竭"。现对峰值源做 nz 包扎(缺失日按 0 参与，绝不会抬高峰值)，并加 500 bar 回退：
//   长窗口有值用长窗口，图表历史不足时退化为可用窗口，两个 length 均为常量，满足 simple int 约束。
float rrp_peak_src = nz(rrp_trillion)
float rrp_peak_lng = ta.highest(rrp_peak_src, 2500)
float rrp_peak_sht = ta.highest(rrp_peak_src, 500)
float rrp_peak     = na(rrp_peak_lng) ? (na(rrp_peak_sht) ? rrp_peak_src : rrp_peak_sht) : rrp_peak_lng
float rrp_pct  = (rrp_data_ok and nz(rrp_peak) > 0) ? (rrp_trillion / rrp_peak) * 100 : float(na)

// 【宏观纪元融合】结合 V56 的绝对值底线与 V57 的相对百分比
// 只要跌破历史峰值 5% (兼容 2.5T 现代巨量)，或者绝对值跌破 0.1T (兼容 2018、2008 旧时代)，均视为枯竭！
bool is_rrp_exhausted = rrp_data_ok ? ((nz(rrp_pct, 100.0) < 5.0) or (nz(rrp_trillion, 999.0) < 0.1)) : false

is_sudden_drain = total_liq_change < gli_mom_threshold
is_breakeven_positive = t10yie > us_inflation_rate

// (V57极速版：剔除ta.percentile动态黑洞周期，使用固定周期)
gli_high_th = ta.percentile_linear_interpolation(total_liq, gli_lookback, gli_high_pct)
gli_low_th = ta.percentile_linear_interpolation(total_liq, gli_lookback, gli_low_pct)

// 【V75 修复 P0-2】LSI 数据完整性闸门：任一分量取不到数据时，LSI 数值不可信，一律不判定
bool lsi_data_ok = not na(sofr_raw) and not na(rrp_rate_raw) and not na(effr_raw) and not na(iorb_raw)
lsi = (sofr - rrp_rate) + (effr - iorb)

is_extreme_tight = lsi_data_ok and lsi >= threshold_extreme_tight
is_tight = lsi_data_ok and not is_extreme_tight and lsi >= threshold_tight
is_gli_loose = gli_bg_active and total_liq > gli_high_th
is_gli_tight = gli_bg_active and total_liq < gli_low_th and not is_gli_loose

is_extreme_loose = lsi_data_ok and (lsi < threshold_extreme_loose) and is_gli_loose
is_normal_loose = lsi_data_ok and (lsi < 0) and not is_extreme_loose and not is_tight and not is_extreme_tight

is_real_tight = dfii10 > th_real_tight * 100
is_real_ext_loose = dfii10 < th_real_ext_loose * 100
breakeven_dev = math.abs(t10yie - us_inflation_rate)
is_breakeven_dev_large = breakeven_dev > th_breakeven_dev * 100
is_stagflation_risk = (dfii10 > th_stagflation_real * 100) and (credit_spread > th_stagflation_credit * 100)

// 【逻辑修复】依赖新的百分比耗尽条件，修复流动性断裂判定
is_liquidity_break = lsi_data_ok and (lsi > threshold_tight) and is_rrp_exhausted

threshold_rate_infl_delta = 50.0
crisis_signal = (math.abs(effr - t10yie) < threshold_rate_infl_delta and math.abs(us02y - t10yie) < threshold_rate_infl_delta) and credit_spread > credit_th

// 【逻辑修复】美联储黄金到顶严格绑定宏观大放水，屏蔽伪宽松误报
bool is_gold_top_macro = fed_liq_top and is_breakeven_dev_large and is_breakeven_positive and (is_gli_loose or is_extreme_loose)

// === 7. 五种宏观状态 ===
state_blackhole   = is_liquidity_break and (credit_spread > credit_th) and (not use_dxy or is_dxy_strong)
state_stagflation = is_stagflation_risk and (t10yie > th_t10yie * 100)
state_supernova   = is_gli_loose and is_real_ext_loose and (credit_spread < 350)
state_gold_regime = is_breakeven_dev_large and is_gs_low and ((effr - us_inflation_rate) < 0)

// === 7.5 V66 短端资金去向雷达 (Bill-OIS / T-Bill ETF / 恒等式净抽水) ===
// 【V64→V66 累计核心改造】
//  ① 货基吸金判定弃用 FRED:M2SL（套改法）
//     M2 总量含活期/储蓄/CDs/小额定期，且月度频率与日频 TGA、准备金不在同一时间尺度，
//     用 5B 阈值判定"货基吸金"既掺入 M1 与储蓄存款噪声，又可能因 na 直接跳过信号。
//     改用两个短端抢筹的直接证据：
//       Bill-OIS = TVC:US03MY − FRED:SOFR，深度倒挂(<−20bp) 代表机构在抢 3M 短债供给
//       AMEX:BIL 成交量 z-score > 2 代表 T-Bill 承接放量
//     M2SL / MMMFFAQ027S 降级为背景展示，不参与任何信号判定。
//  ② TGA 抽水改为美联储恒等式口径的"净抽水"
//     Fed 负债端恒等式: Δ准备金 = −(ΔTGA + ΔRRP + Δ流通现金 + Δ其他负债)
//     单看 ΔTGA 分不清"财政真抽水"与"发债回吐"：TGA 涨而 RRP 同步释放，只是负债端内部搬家，
//     准备金不变，对市场不构成抽水。V66 用三渠道合计 ΔTGA+ΔRRP+Δ现金 判定净抽水。
//  ③ 新增恒等式残差校验
//     残差 = 净抽水 − 准备金实际减少量，正常应互相抵消；残差超容忍值说明 Fed 资产端或
//     其他负债项(foreign repo pool / Treasury 预付 / 其他存款)有异常变动，须人工甄别数据源。
//  ④ 【V67】残差归因层（只加文案，不改任何判定）
//     残差超容忍值时，在报警串后追加一行归因，按"成本从低到高"顺序排查：
//     准备金周度序列(FRED:WRESBAL)更新时点错配(假残差) → 缴税窗口划转错配 → 净发债未被 RRP 承接的真实抽水
//     → 最后才归入 Fed 其他负债项(外国回购池/财政预付款/其他存款)。
//     净发债配对口径：货币基金只能用回流 RRP 的现金买新发债，故 RRP 释放量 = 发债中"不动准备金"的部分；
//     TGA 增量扣除 RRP 承接后仍未覆盖的，只能由银行准备金或残差项出资。
//  ⑤ 【V68】LSI 折线彻底停绘（注释掉 plot）；LSI 相关背景色带按用户要求回滚为常开、不设开关。
//  ⑥ 【V69 布局】换行函数由"等分切"改为"贪心装填+语义断点"；资金去向行宽(默认110)、AI 各段行宽(默认85)开放为 input。
//     内容去重：原始数值统一留在看板行3，AI 首段与二阶不再复述 TGA/RRP/现金/准备金明细及买卖盘明细。
//  ⑦ 【V70】移除「[交叉验证]」串(flow_cross)。原因：该串把 V57 旧口径(10bar)与恒等式口径(20bar)的合计差
//     在资金去向行尾再报一次，与看板行3的唯一权威数值形成双数值歧义；且两口径共用同一组数据源
//     (WDTGAL / WLRRAL / RRPONTSYD)，仅回溯窗口不同，属同源自比而非独立信源互证；判断阈值又复用了
//     v62_ident_tol(残差容忍)，语义错配。现整串删除，资金去向行只保留一个权威数值；
//     V57 旧口径仅保留为 use_v62=false 时的完整回退分支(flow_legacy)，不再向外输出对比数值。
//  ⑧ 【V71】新增资产端(WALCL)校验，残差归因优先级重排
//     恒等式 Δ准备金 = −(ΔTGA+ΔRRP+Δ现金+Δ其他负债) 只覆盖负债端三渠道；若 Fed 资产端收缩
//     (到期不续买 / 主动卖债)，负债端同步减少、准备金同样被抽走，却不在这三渠道里，于是只能
//     表现为残差为负(准备金实际减少量 > 三渠道合计)。V67 此前一律把这种负残差推给"Fed 其他
//     负债项异常"，方向正确但归因可能错到隔壁科目。
//     现引入 FRED:WALCL(周度总资产) 近 N bar 变动做资产端校验，判定顺序前移到其他负债项之前：
//     残差超容忍且为负 → 资产端收缩达阈值(B)且收缩量能覆盖残差一定比例 → 归因缩表(QT)，
//     不再归入其他负债项异常；资产端持平或扩表 → 明确排除缩表，残差才继续走 V67 既有分支。
//     看板行3 新增"资产端Δ"读数(正=扩表/负=缩表)，标签只在残差超容忍时参与文案，不改任何既有布尔判定。
//  ⑨ 【V72】看板换行改按「视觉列」计宽(修复横向过宽、向左压掉 K 线区)
//     V69 的贪心装填换行解决的是"末块留白 / 数字串被拦腰切断"，但度量单位仍是 str.length() 字符数；
//     而中文/全角标点/emoji 的显示宽度约为 ASCII 的 2 倍，v69_w_flow=110「字符」的混排行
//     实际占 170~190 视觉列，单行把看板撑到约 1100px，向左压掉 K 线绘图区(实测截图确认)。
//     改法：换行函数内部按显示宽度计列——ASCII 可打印字符 1 列、中文/全角/emoji 2 列；
//     参数语义由"字符数"改为"视觉列"：v69_w_flow 110(字符,≈137列)→104、v69_w_ai 85(字符,≈145列)→100；
//     第4行「宏观状态 ➔ 触发项」的硬编码 65(≈110列) 提为 v72_w_state(默认 76 视觉列)。
//     只改渲染宽度，不改任何判定、不改任何文案内容；v72_width_aware=false 可整体回退 V69 字符口径。
//  ⑩ 【V73】右侧留白根治(A 算法修正 + B 四段合流)，纵向高度净减 4~5 行
//     [V75 注] 本段出现的 6 / ≤17 列 / 104 等均为 V73 当时的默认值，现已被 ⑪(113/130/130、10) 覆盖，
//     但 A1 的算法(mc/v73_back_div)、A3+B 的合流逻辑与 v73_back_div 开关全部保留，未被删除。
//     现象：资金去向行已不超宽，但第5行「三阶段详细分析」右侧仍空出很大一块，看板整体偏高。
//     根因1(填充率)：V72 的回退容差 back_max = mc/2，104 列的行最多可向前回退 52 列去找分隔符，
//       一旦附近有「；」「、」「）」就提前断行，不少行实际只占 50~70% 宽度 —— 这是"空很大"的主因。
//     改法A1：回退容差收窄为 mc/v73_back_div(默认 6，即 ≤17 列)，每行强制填充率 ≥83%；
//       容差过大才会被单个标点过早截断，收窄后只在硬切点前极近处找分隔符，不会被切断感明显。
