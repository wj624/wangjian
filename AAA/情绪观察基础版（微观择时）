// =========================================================================
// 👑 【全局作用域平移】T0-T3 丝带时序评估内核 (区分左侧箱体潜伏与右侧突破空间核算)
// =========================================================================
float boxTargetPrice = vwLl + (vwHh - vwLl) * (vwTargetLevel / 100.0)
float boxStopPrice   = vwLl
// 🛠️ 当触发右侧突破(ACT_FOLLOW/ACT_STRONG_BUY)且价格已接近或突破箱体目标位时，自动切换为 ATR 右侧趋势延展目标与跟踪止损
bool isRightSideBreak = (actionCode == ACT_FOLLOW or actionCode == ACT_STRONG_BUY or isTrueBreakoutUp) and (close >= boxTargetPrice * 0.98)
float targetPrice = isRightSideBreak ? (close + atr * atrMult * minRrr) : boxTargetPrice
float stopPrice   = isRightSideBreak ? math.max(close - atr * atrMult, vwLl) : boxStopPrice
float reward      = targetPrice - close
float risk        = close - stopPrice
float safeRisk    = math.max(risk, nz(atr * 0.1, minTickSafe), minTickSafe)
float rrr         = reward > 0 ? math.min(reward / safeRisk, 99.9) : 0.0
float rewardPct   = (reward / math.max(close, 1e-10)) * 100.0

bool isT0 = actionCode == ACT_ESCAPE or actionCode == ACT_HARD_SELL or actionCode == ACT_STRONG_BUY
bool isT1 = (topScore >= 2) or (botScore >= 2 and bullFilterPassed) or (showVwKdj and (vwBuyCond or vwSellCond)) or actionCode == ACT_REDUCE or actionCode == ACT_WARN_SELL
bool isT2 = actionCode == ACT_HOLD or actionCode == ACT_FOLLOW or actionCode == ACT_ACCUMULATE

color rrrGlobalColor = color.white
if reward <= 0
    rrrGlobalColor := color.new(#ffffff, 0)
else if rewardPct < minProfitPct
    rrrGlobalColor := color.rgb(255, 82, 82)
else if rrr < minRrr
    rrrGlobalColor := color.rgb(255, 152, 0)
else
    rrrGlobalColor := color.rgb(0, 255, 128)

color finalTColor = color.rgb(253, 253, 253)
if isT0
    finalTColor := backtestSignal == 1 ? color.rgb(0, 255, 128) : color.rgb(255, 50, 50)
else if isT1
    finalTColor := color.rgb(255, 152, 0)
else if isT2
    // 🛠️ 仅对左侧箱体潜伏(ACT_ACCUMULATE)执行箱体80%分位盈亏比一票否决，不再错误扼杀右侧真突破(ACT_FOLLOW)
    if (actionCode == ACT_ACCUMULATE) and (rewardPct < minProfitPct or rrr < minRrr) and (reward > 0)
        finalTColor := rrrGlobalColor
    else
        finalTColor := color.rgb(0, 213, 255)

