executeLabelEngine(cond, allowConfirmed, allowLive, txt, colorBg, colorText, sz, yVal, offset, lblStyle, container, currentHandle) =>
    label updatedHandle = currentHandle
    if cond
        if barstate.isconfirmed
            if not na(currentHandle)
                label.delete(currentHandle)
            if allowConfirmed
                label lbl = label.new(bar_index - offset, yVal, text=txt, color=colorBg, textcolor=colorText, style=lblStyle, size=sz)
                array.push(container, lbl)
                while array.size(container) > safePoolMax
                    label.delete(array.shift(container))
            updatedHandle := na
        else if allowLive
            if not na(currentHandle)
                label.delete(currentHandle)
            updatedHandle := label.new(bar_index - offset, yVal, text=txt + " ⏳", color=colorBg, textcolor=colorText, style=lblStyle, size=sz)
    else if not barstate.isconfirmed
        if not na(currentHandle)
            label.delete(currentHandle)
        updatedHandle := na
    updatedHandle

