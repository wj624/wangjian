        table.cell(atrTable, 2, 5, chipCombinedStr, text_color=chipStatusColor, text_size=size.small, text_halign=text.align_right)

        table.cell(atrTable, 0, 6, "今日微观异动", text_color=color.white, text_size=size.small, text_halign=text.align_left)
        table.cell(atrTable, 1, 6, str.tostring(vol_z_score, "#.##") + " 倍标准差", text_color=color.white, text_size=size.small, text_halign=text.align_center)
        table.cell(atrTable, 2, 6, volActionStr, text_color=volActionColor, text_size=size.small, text_halign=text.align_right)

        table.cell(atrTable, 0, 7, finalTLevel, text_color=finalTColor, text_size=size.small, text_halign=text.align_left)
        table.cell(atrTable, 1, 7, matrixStatus, text_color=matrixColor, text_size=size.small, text_halign=text.align_center)
        table.cell(atrTable, 2, 7, ultimateAction, text_color=finalTColor, text_size=size.small, text_halign=text.align_right)

        // ==================== 极值共振触发项目诊断与渲染 ====================
        string resStatus = "未触发"
        color resBgCol = color.new(color.gray, 80)
        color resTextCol = color.rgb(180, 180, 180)
        string resItems = "无"

        bool isTopRes = showBgAlert and (topScore >= 2)
        bool isBotRes = showBgAlert and (botScore >= 2 and bullFilterPassed)

        if isTopRes and isBotRes
            resStatus := "多空分歧 (" + str.tostring(topScore) + ":" + str.tostring(botScore) + ")"
            resBgCol := color.new(color.purple, 40)
            resTextCol := color.white
            resItems := "顶底信号同时满足"
        else if isTopRes
            resStatus := "顶共振 (" + str.tostring(topScore) + "分)"
            resBgCol := topScore == 5 ? color.new(#ff5252, 20) : topScore == 4 ? color.new(#ff5252, 40) : topScore == 3 ? color.new(#ff5252, 60) : color.new(#ff5252, 75)
            resTextCol := color.white

            string tItems = ""
            if osc >= rsiOverbought
                tItems := tItems + (tItems == "" ? "" : "+") + "RSI超买"
            if macdTurnDown and macdHist > 0
                tItems := tItems + (tItems == "" ? "" : "+") + "MACD红柱缩短"
            if closeCci >= cciExtremeOB
                tItems := tItems + (tItems == "" ? "" : "+") + "CCI极超买"
            if mfiVal >= 80
                tItems := tItems + (tItems == "" ? "" : "+") + "MFI资金超买"
            if climaxCloudBear
                tItems := tItems + (tItems == "" ? "" : "+") + "双云图高位"
            resItems := tItems

        else if isBotRes
            resStatus := "底共振 (" + str.tostring(botScore) + "分)"
            resBgCol := botScore == 5 ? color.new(#4caf4f, 20) : botScore == 4 ? color.new(#4caf4f, 40) : botScore == 3 ? color.new(#4caf4f, 60) : color.new(#4caf4f, 75)
            resTextCol := color.white

            string bItems = ""
            if osc <= rsiOversold
                bItems := bItems + (bItems == "" ? "" : "+") + "RSI超卖"
            if macdTurnUp and macdHist < 0
                bItems := bItems + (bItems == "" ? "" : "+") + "MACD绿柱缩短"
            if closeCci <= cciExtremeOS
                bItems := bItems + (bItems == "" ? "" : "+") + "CCI极超跌"
            if mfiVal <= 20
                bItems := bItems + (bItems == "" ? "" : "+") + "MFI资金冰点"
            if climaxCloudBull
                bItems := bItems + (bItems == "" ? "" : "+") + "双云图低位"
            resItems := bItems

        // 填入第 8 行单元格
        table.cell(atrTable, 0, 8, "极值共振状态", text_color=color.white, text_size=size.small, text_halign=text.align_left)
        table.cell(atrTable, 1, 8, resStatus, bgcolor=resBgCol, text_color=resTextCol, text_size=size.small, text_halign=text.align_center)
        table.cell(atrTable, 2, 8, resItems, text_color=resTextCol, text_size=size.tiny, text_halign=text.align_right)

