// 🛠️ 自适应价格精度格式化函数（兼容高价股/指数与极低价加密货币/外汇）
f_fmtPrice(float val) =>
    string res = ""
    if not useAutoPrecision
        res := str.tostring(val, "#.####")
    else
        float absVal = math.abs(val)
        if absVal >= 1000
            res := str.tostring(val, "#.##")
        else if absVal >= 1
            res := str.tostring(val, "#.####")
        else if absVal >= 0.001
            res := str.tostring(val, "#.######")
        else
            res := str.tostring(val, format.mintick)
    res

// ==================== [ 第一阶段：底层引擎计算 ] ====================
float minTickSafe = math.max(syminfo.mintick, 1e-10)
float vwSafeVol = na(volume) or volume == 0 ? 1.0 : volume
float osc = ta.rsi(src, len)

float tp = hlc3
float rawMoneyFlow = tp * vwSafeVol
float posFlow = tp > tp[1] ? rawMoneyFlow : 0.0
float negFlow = tp < tp[1] ? rawMoneyFlow : 0.0
float sumPosFlow = math.sum(posFlow, mfiLen)
float sumNegFlow = math.sum(negFlow, mfiLen)
float safeNegFlow = sumNegFlow == 0 ? 0.000001 : sumNegFlow
float mfiVal = 100.0 - (100.0 / (1.0 + (sumPosFlow / safeNegFlow)))

[_, _, macdHist] = ta.macd(src, macdFast, macdSlow, macdSignal)
float closeCci = ta.cci(hlc3, cciLen)

float atr = ta.atr(atrLen)
float atrMax = ta.highest(atr, atrLookback)
float atrMin = ta.lowest(atr, atrLookback)
float atrPercent = (atr - atrMin) / math.max(atrMax - atrMin, 1e-10) * 100.0
float normalizedAtr = (atrPercent / 100.0) * atrMaxHeight
color atrColor = atrPercent >= 80 ? color.new(color.orange, 60) : atrPercent <= 20 ? color.new(color.green, 60) : color.new(#787B86, 80)

float maEma = ta.ema(close, maLen)
float maSma = ta.sma(close, maLen)
float maVal = maType == "EMA" ? maEma : maSma
float maDist = close - maVal
float maRatio = (maDist / math.max(close, 1e-10)) * 100.0

// 🎯 筹码重心算法
float chipGravityLine = math.sum(vwSafeVol * hlc3, chipLen) / math.max(math.sum(vwSafeVol, chipLen), 1e-10)
float chipDistRatio = (close - chipGravityLine) / math.max(chipGravityLine, 1e-10) * 100.0

// 🧬 自适应标准差（修正：解除硬编码 1.0% 死锁，结合真实 ATR 波幅百分比自适应分时图与低波外汇/黄金）
float atrBasePct = (atr / math.max(close, 1e-10)) * 100.0
float chipStdDev = ta.stdev(chipDistRatio, chipLen)
float safeChipStdDev = math.max(nz(chipStdDev, atrBasePct), atrBasePct * 0.25, 0.05)

float chipThreshold = safeChipStdDev * thresholdMult
float chipExtreme = safeChipStdDev * extremeMult
float chipNeutral = math.max(safeChipStdDev * neutralMult, atrBasePct * 0.1)

string volMod = atrPercent >= 80 ? " (剧烈)" : atrPercent <= 20 ? " (极静)" : " (稳健)"
string baseChipStatus = ""
string actionSignal = ""
color chipStatusColor = color.white

if chipDistRatio > chipExtreme
    baseChipStatus := "情绪泡沫"
    actionSignal := " (空)"
    chipStatusColor := color.rgb(255, 0, 0)
else if chipDistRatio > chipThreshold
    baseChipStatus := "良性洗盘"
    actionSignal := " (多)"
    chipStatusColor := color.rgb(0, 255, 128)
else if chipDistRatio > chipNeutral
    baseChipStatus := "中枢偏强"
    actionSignal := " (等/多)"
    chipStatusColor := color.rgb(255, 152, 0)
else if chipDistRatio >= -chipNeutral
    baseChipStatus := "中枢震荡"
    actionSignal := " (等)"
    chipStatusColor := color.rgb(255, 255, 255)
else if chipDistRatio > -chipThreshold
    baseChipStatus := "中枢偏弱"
    actionSignal := " (等/空)"
    chipStatusColor := color.rgb(153, 204, 255)
else if chipDistRatio >= -chipExtreme
    baseChipStatus := "底部吸筹"
    actionSignal := " (多)"
    chipStatusColor := color.rgb(255, 235, 59)
else
    baseChipStatus := "极限错杀"
    actionSignal := " (多)"
    chipStatusColor := color.rgb(0, 213, 255)

string chipStatus = baseChipStatus + volMod + actionSignal

float volMa = ta.sma(vwSafeVol, 20)
bool volClimax = vwSafeVol > volMa * volMultInput
float ema9 = ta.ema(close, 9)
bool priceConfirm = close > ema9
bool anyVolClimaxRecently = math.sum(volClimax ? 1 : 0, lbR + 1) > 0
bool bullFilterPassed = not useVolFilter or (anyVolClimaxRecently or priceConfirm)

float rsiPctUpper = ta.percentile_linear_interpolation(osc, pctLen, 80)
float rsiPctLower = ta.percentile_linear_interpolation(osc, pctLen, 20)
float mfiPctUpper = ta.percentile_linear_interpolation(mfiVal, pctLen, 80)
float mfiPctLower = ta.percentile_linear_interpolation(mfiVal, pctLen, 20)

// ==================== 顾比均线核心 ====================
float gS1 = ta.ema(gmmaSrc, 3)
float gS2 = ta.ema(gmmaSrc, 5)
float gS3 = ta.ema(gmmaSrc, 8)
float gS4 = ta.ema(gmmaSrc, 10)
float gS5 = ta.ema(gmmaSrc, 12)
float gS6 = ta.ema(gmmaSrc, 15)

float gL1 = ta.ema(gmmaSrc, 30)
float gL2 = ta.ema(gmmaSrc, 35)
float gL3 = ta.ema(gmmaSrc, 40)
float gL4 = ta.ema(gmmaSrc, 45)
float gL5 = ta.ema(gmmaSrc, 50)
float gL6 = ta.ema(gmmaSrc, 60)

int crossScore = 0
crossScore := crossScore + (gS1 > gL1 ? 1 : -1) + (gS1 > gL2 ? 1 : -1) + (gS1 > gL3 ? 1 : -1) + (gS1 > gL4 ? 1 : -1) + (gS1 > gL5 ? 1 : -1) + (gS1 > gL6 ? 1 : -1)
crossScore := crossScore + (gS2 > gL1 ? 1 : -1) + (gS2 > gL2 ? 1 : -1) + (gS2 > gL3 ? 1 : -1) + (gS2 > gL4 ? 1 : -1) + (gS2 > gL5 ? 1 : -1) + (gS2 > gL6 ? 1 : -1)
crossScore := crossScore + (gS3 > gL1 ? 1 : -1) + (gS3 > gL2 ? 1 : -1) + (gS3 > gL3 ? 1 : -1) + (gS3 > gL4 ? 1 : -1) + (gS3 > gL5 ? 1 : -1) + (gS3 > gL6 ? 1 : -1)
crossScore := crossScore + (gS4 > gL1 ? 1 : -1) + (gS4 > gL2 ? 1 : -1) + (gS4 > gL3 ? 1 : -1) + (gS4 > gL4 ? 1 : -1) + (gS4 > gL5 ? 1 : -1) + (gS4 > gL6 ? 1 : -1)
crossScore := crossScore + (gS5 > gL1 ? 1 : -1) + (gS5 > gL2 ? 1 : -1) + (gS5 > gL3 ? 1 : -1) + (gS5 > gL4 ? 1 : -1) + (gS5 > gL5 ? 1 : -1) + (gS5 > gL6 ? 1 : -1)
crossScore := crossScore + (gS6 > gL1 ? 1 : -1) + (gS6 > gL2 ? 1 : -1) + (gS6 > gL3 ? 1 : -1) + (gS6 > gL4 ? 1 : -1) + (gS6 > gL5 ? 1 : -1) + (gS6 > gL6 ? 1 : -1)

int shortOrder = (gS1 > gS2 ? 1 : -1) + (gS2 > gS3 ? 1 : -1) + (gS3 > gS4 ? 1 : -1) + (gS4 > gS5 ? 1 : -1) + (gS5 > gS6 ? 1 : -1)
int longOrder  = (gL1 > gL2 ? 1 : -1) + (gL2 > gL3 ? 1 : -1) + (gL3 > gL4 ? 1 : -1) + (gL4 > gL5 ? 1 : -1) + (gL5 > gL6 ? 1 : -1)

int gmmaNetScore = crossScore + shortOrder + longOrder
float longMax = math.max(gL1, gL2, gL3, gL4, gL5, gL6)
float longMin = math.min(gL1, gL2, gL3, gL4, gL5, gL6)
float longWidth = longMax - longMin
float avgLongWidth = ta.sma(longWidth, 100)
bool isLongContracted = longWidth < (avgLongWidth * 0.6)

color dynamicGmmaColor = na
float safeEntangleDenom = math.max(46.0 - entangleThreshold, 1.0)
if math.abs(gmmaNetScore) <= entangleThreshold or isLongContracted
    float yellowRatio = (gmmaNetScore + entangleThreshold) / math.max(entangleThreshold * 2.0, 1.0)
    dynamicGmmaColor := color.from_gradient(yellowRatio * 100.0, 0, 100, color.new(#ffaa00, 30), color.new(#bbff00, 48))
else
    if gmmaNetScore > 0
        float bullRatio = (gmmaNetScore - entangleThreshold) / safeEntangleDenom
        dynamicGmmaColor := color.from_gradient(bullRatio * 100.0, 0, 100, color.new(#80c904, 35), color.new(#00bd0d, 15))
    else
        float bearRatio = (math.abs(gmmaNetScore) - entangleThreshold) / safeEntangleDenom
        dynamicGmmaColor := color.from_gradient(bearRatio * 100.0, 0, 100, color.new(#ff6a00, 35), color.new(#ff1100, 15))

// ==================== VW-KDJ 核心 ====================
float vwCurrentVolat = high - low
float vwAvgVolat = ta.sma(vwCurrentVolat, 20)
float vwVolatWeight = math.min(vwCurrentVolat / math.max(vwAvgVolat, 1e-10), 2.0)
float vwSmartVolume = vwSafeVol * vwVolatWeight

custom_vwma(src_val, length) =>
    math.sum(src_val * vwSmartVolume, length) / math.max(math.sum(vwSmartVolume, length), 1e-10)

float vwma3 = custom_vwma(close, 3)
