    targetStr = str.tostring(atrStopDist, "#.####") + " (" + str.tostring(atrRatio, "#.##") + "%)"
    maPriceStr = str.tostring(maVal, "#.####")
    maDiffStr = str.tostring(maDist, "#.####") + " (" + str.tostring(maRatio, "#.##") + "%)"
    color maInfoColor = maDist >= 0 ? color.rgb(12, 255, 20) : color.rgb(255, 0, 0)
    
    string rrrEvalStr = ""
    if reward <= 0
        rrrEvalStr := "已达目标位"
    else if rewardPct < minProfitPct
        rrrEvalStr := "肉小放弃"
    else if rrr < minRrr
        rrrEvalStr := "风险失衡"
    else
        rrrEvalStr := "盈亏比优"
        
    string tgtStr    = str.tostring(targetPrice, "#.####")
    string tgtPctStr = (rewardPct > 0 ? "+" : "") + str.tostring(rewardPct, "#.##") + "%"
    string stpStr    = str.tostring(stopPrice, "#.####")
    string rrrValStr = "盈亏比: " + str.tostring(rrr, "#.##")
    
    string finalTLevel = ""
    string ultimateAction = ""
    
    if isT0
        finalTLevel := "T0 统帅"
        string prefixT0 = backtestSignal == 1 ? "[最高指令] " : "[一票否决] "
        ultimateAction := prefixT0 + matrixAction
    else if isT1
        finalTLevel := "T1 警戒"
        ultimateAction := "[极值警戒] " + (matrixAction == "" ? "设硬风控" : matrixAction)
    else if isT2
        finalTLevel := "T2 风控"
        if (actionCode == ACT_ACCUMULATE or actionCode == ACT_FOLLOW) and (rewardPct < minProfitPct or rrr < minRrr) and (reward > 0)
            ultimateAction := "[放弃] " + rrrEvalStr
        else
            ultimateAction := "[T2] " + matrixAction
    else
        finalTLevel := "T3 前哨"
        if (rewardPct < minProfitPct or rrr < minRrr) and (reward > 0)
            ultimateAction := "[观望] " + rrrEvalStr
        else
            ultimateAction := "[T3] " + matrixAction

