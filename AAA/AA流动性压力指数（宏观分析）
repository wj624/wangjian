f_auto_wrap(txt, max_chars) =>
    string result = ""
    int str_len = str.length(txt)
    if str_len <= max_chars
        result := txt
    else
        int chunks = int(math.ceil(str_len / float(max_chars)))
        int loop_end = chunks - 1
        for i = 0 to loop_end
            int start_pos = i * max_chars
            int end_pos = math.min((i + 1) * max_chars, str_len)
            result += str.substring(txt, start_pos, end_pos) + (end_pos < str_len ? "\n" : "")
    result

