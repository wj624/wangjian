    if is_sudden_drain
        l2_pipes += "🚨异常闪崩警报：监测到全球总资金池周期环比骤降(" + str.tostring(total_liq_change, "#.##") + "%)，警惕流动性真空引发的极速闪崩！"
    else if is_impulse_waning
