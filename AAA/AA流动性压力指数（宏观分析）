//@version=6
indicator("流动性压力指数", shorttitle="流动性压力61版", overlay=false)

// === 1. 参数 & 阈值 ===
group_lsi = "LSI (美元体系内部压力)"
src_sofr = input.string("FRED:SOFR", "SOFR 数据源", group=group_lsi)
src_rrp = input.string("FRED:RRPONTSYAWARD", "RRP 利率数据源", group=group_lsi)
src_effr = input.string("FRED:EFFR", "有效聯邦基金利率來源", options=["FRED:EFFR", "FRED:DFF"], group=group_lsi)
src_iorb = input.string("FRED:IORB", "IORB 数据源", group=group_lsi)
src_us02y = input.string("TVC:US02Y", "2年期美債收益率來源", options=["TVC:US02Y", "FRED:DGS2"], group=group_lsi)
src_us10y = input.string("TVC:US10Y", "10年期美债收益率来源", options=["TVC:US10Y", "FRED:DGS10"], group=group_lsi)
src_t10yie = input.string("FRED:T10YIE", "T10YIE 数据源", group=group_lsi)
src_dfii10 = input.string("FRED:DFII10", "DFII10 真实长期收益率", group=group_lsi)
src_credit_spread = input.string("FRED:BAMLH0A0HYM2", "信用利差数据源", group=group_lsi)
src_usiryy = input.string("ECONOMICS:USIRYY", "美国通胀 YoY", group=group_lsi)
threshold_tight = input.float(20.0, "LSI 紧张阈值 (bps)", group=group_lsi)
threshold_extreme_tight = input.float(50.0, "LSI 极端紧张 (bps)", group=group_lsi)
threshold_extreme_loose = input.float(-30.0, "LSI 极端宽松 (bps)", group=group_lsi)
th_t10yie = input.float(2.5, "10Y通胀预期红色阈值 (%)", group=group_lsi)
th_inf_yoy = input.float(3.0, "通胀YoY红色阈值 (%)", group=group_lsi)

// [优化] 斜率动量参数 (真正危机捕获版)
group_curve = "收益率曲线斜率报警 (危机捕获版)"
curve_lookback = input.int(10, "斜率变动计算周期(天)", group=group_curve)
us02y_drop_th = input.float(20.0, "牛陡:2年期暴跌阈值(BP)", group=group_curve, tooltip="2年期在周期内暴跌超过此值(如-20BP)，代表市场恐慌定价降息，衰退前兆")
us10y_spike_th = input.float(20.0, "熊陡:10年期暴涨阈值(BP)", group=group_curve, tooltip="10年期在周期内暴涨超过此值(如+20BP)，代表长端流动性崩盘或通胀失控")
spread_change_th = input.float(10.0, "利差走阔最低阈值(BP)", group=group_curve, tooltip="要求10Y-2Y利差在周期内实打实地拉开")

group_enh_new = "强美元与动量附加设置"
use_dxy = input.bool(true, "启用 DXY 强美元惩罚(黑洞状态)", group=group_enh_new)
src_dxy = input.string("TVC:DXY", "美元指数(DXY)数据源", group=group_enh_new)
dxy_ma_len = input.int(50, "美元指数趋势判定MA周期", group=group_enh_new)

use_credit_roc = input.bool(true, "启用 信用利差动量急升预警", group=group_enh_new)
credit_roc_len = input.int(10, "信用利差动量检测周期(日)", group=group_enh_new)
credit_roc_th = input.float(10.0, "信用利差急升预警阈值(%)", group=group_enh_new)

group_adv = "高级报警设置"
gold_th = input.float(-350.0, "黄金到顶判定阈值 (有效利率EFFR-CPI)", group=group_adv)
credit_th = input.float(400.0, "危机判定信用利差阈值 (bps)", group=group_adv)
reserve_gdp_threshold = input.float(0.11, "准备金/GDP 不足阈值 (11%警戒线)", minval=0.0, maxval=1.0, step=0.01, group=group_adv)
reserve_assets_threshold = input.float(0.11, "准备金/银行总资产 不足阈值", minval=0.0, maxval=1.0, step=0.01, group=group_adv)
ma_period = input.int(10, "美联储黄金到顶 MA 周期", minval=1, group=group_adv)

group_alert_enh = "增强报警 - 实际利率 & 通胀偏差 & 滞胀"
th_real_tight = input.float(2.2, "实际利率 显著紧缩阈值 (%)", group=group_alert_enh)
th_real_ext_loose = input.float(0.0, "实际利率 极度宽松阈值", group=group_alert_enh)
th_breakeven_dev = input.float(0.9, "⚠通胀预期 vs 现实偏差（绝对值）", group=group_alert_enh)
th_stagflation_real = input.float(1.8, "⚠滞胀+信用压力双杀 实际利率", group=group_alert_enh)
th_stagflation_credit = input.float(4.0, "⚠滞胀+信用压力双杀 信用利差", group=group_alert_enh)

group_s5th = "S5TH 广度报警 (S&P 500 200日均线上方股票占比)"
s5th_symbol = input.string("INDEX:S5TH", "S5TH 数据源", group=group_s5th)
s5th_weak_th = input.float(80.0, "S5TH 弱化预警阈值 (%)", group=group_s5th)
s5th_severe_th = input.float(60.0, "S5TH 严重崩坏阈值 (%)", group=group_s5th)
use_s5th_alert = input.bool(true, "启用 S5TH 广度报警", group=group_s5th)
s5th_overheat_th = input.float(80.0, "S5TH 过热阈值（≥ 此值提示经济过热）", group=group_s5th)
s5th_bottom_th   = input.float(15.5, "S5TH 底部阈值（≤ 此值提示市场底部）", group=group_s5th)

group_gsr = "金银比报警 (Gold/Silver Ratio)"
use_gsr_alert = input.bool(true, "启用金银比报警", group=group_gsr)
gsr_low_threshold  = input.float(50.0, "金银比偏低阈值", group=group_gsr)
gsr_high_threshold = input.float(80.0, "金银比偏高阈值", group=group_gsr)

group_gli = "全球流动性总量 (背景报警设置)"
gli_bg_active = input.bool(true, "启用全球总量背景报警", group=group_gli)
use_fed = input.bool(true, "计入 FED", group=group_gli)
use_tga = input.bool(true, "扣除 TGA", group=group_gli)
use_rrp = input.bool(true, "扣除 RRP", group=group_gli)
use_ecb = input.bool(true, "计入 ECB", group=group_gli)
use_pbc = input.bool(true, "计入 PBC", group=group_gli)
use_boj = input.bool(true, "计入 BOJ", group=group_gli)
gli_lookback = input.int(250, "背景判定回溯周期 (日)", group=group_gli)
gli_high_pct = input.float(75, "总量：高位宽松触发点", group=group_gli)
gli_low_pct = input.float(25, "总量：低位收缩触发点", group=group_gli)
gli_mom_lookback = input.int(20, "增长率检测周期 (天)", group=group_gli)
gli_mom_threshold = input.float(-1.0, "周环比骤减报警阈值 (%)", group=group_gli)

group_ui = "UI与看板设置"
table_size_str = input.string("Small", title="看板字体大小", options=["Tiny", "Small", "Normal", "Large", "Huge"], group=group_ui)
table_size = table_size_str == "Tiny" ? size.tiny : table_size_str == "Small" ? size.small : table_size_str == "Normal" ? size.normal : table_size_str == "Large" ? size.large : size.huge

group_flow = "V57 资金流向雷达设置"
flow_lookback = input.int(10, "流向计算周期 (天)", group=group_flow)
flow_threshold = input.float(5.0, "有效动作过滤阈值 (Billion)", group=group_flow)

// === 2. 最高稳定性统一请求函数 (已为了V57极速性能重构，解除嵌套节省算力) ===

// === 3. 数据符号定义 ===
s_fed   = "ECONOMICS:USCBBS"
s_ecb   = "ECONOMICS:EUCBBS"
s_pbc   = "ECONOMICS:CNCBBS"
s_boj   = "ECONOMICS:JPCBBS"
s_eurusd = "FX_IDC:EURUSD"
s_cnyusd = "FX_IDC:CNYUSD"
s_jpyusd = "FX_IDC:JPYUSD"
s_tga   = "FRED:WTREGEN"
s_rrp_b = "FRED:RRPONTSYD"
src_WRBWFRBL = "FRED:WRBWFRBL"
src_TLAACBM027SBOG = "FRED:TLAACBM027SBOG"
src_GDP = "FRED:GDP"

// === 4. 数据请求 (V61：100%采用59版原生单位体系，并显式加入 lookahead_off 防重绘与配额合并优化) ===
raw_fed = request.security(s_fed, "D", close, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
raw_ecb = request.security(s_ecb, "D", close, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
raw_pbc = request.security(s_pbc, "D", close, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
raw_boj = request.security(s_boj, "D", close, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

raw_eurusd = request.security(s_eurusd, "D", close, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
raw_cnyusd = request.security(s_cnyusd, "D", close, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
raw_jpyusd = request.security(s_jpyusd, "D", close, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

raw_tga = request.security(s_tga, "D", close, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
raw_rrp_b = request.security(s_rrp_b, "D", close, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

fed_bal      = use_fed  ? nz(raw_fed) : 0.0
ecb_bal_raw  = use_ecb  ? nz(raw_ecb) : 0.0
pbc_bal_raw  = use_pbc  ? nz(raw_pbc) : 0.0
boj_bal_raw  = use_boj  ? nz(raw_boj) : 0.0

eur_usd = use_ecb ? nz(raw_eurusd, nz(raw_eurusd[1], 1.196)) : 1.0
cny_usd = use_pbc ? nz(raw_cnyusd, nz(raw_cnyusd[1], 0.144)) : 1.0
jpy_usd = use_boj ? nz(raw_jpyusd, nz(raw_jpyusd[1], 0.00652)) : 1.0

tga_bal = use_tga ? nz(raw_tga) : 0.0
rrp_bal = use_rrp ? nz(raw_rrp_b) : 0.0

reserves_raw_display = request.security("FRED:WRESBAL", "D", close, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
wr_bal_raw_display   = request.security(src_WRBWFRBL, "D", close, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
total_assets_display = request.security(src_TLAACBM027SBOG, "D", close, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
gdp_raw              = request.security(src_GDP, "D", close, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

s5th_raw     = request.security(s5th_symbol, "D", close, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
gold_price   = request.security("TVC:GOLD", "D", close, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
silver_price = request.security("TVC:SILVER", "D", close, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

wdtgal   = request.security("FRED:WDTGAL", "D", close, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
wrbwfrbl = wr_bal_raw_display
// 合并 DXY 与其均线请求，节省算力并保持结果100%一致
[dxy_raw, dxy_ma] = request.security(src_dxy, "D", [close, ta.sma(close, dxy_ma_len)], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

wlrr = request.security("FRED:WLRRAL", "D", close, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

// 严格采用 59 版单位换算 (/ 1e9)，同时使用 raw_rrp_b 防止用户关闭 GLI 的 use_rrp 开关时破坏资金流向雷达
delta_tga_b  = (wdtgal - nz(wdtgal[flow_lookback], wdtgal)) / 1000000000 
delta_wlrr_b = (wlrr - nz(wlrr[flow_lookback], wlrr)) / 1000000000
delta_rrp_b  = (raw_rrp_b - nz(raw_rrp_b[flow_lookback], raw_rrp_b)) / 1000000000

max_drain = math.max(delta_tga_b, math.max(delta_wlrr_b, delta_rrp_b))
min_inject = math.min(delta_tga_b, math.min(delta_wlrr_b, delta_rrp_b))

string drain_name = max_drain == delta_tga_b ? "TGA" : max_drain == delta_wlrr_b ? "外国逆回购" : "国内逆回购"
string inject_name = min_inject == delta_tga_b ? "TGA" : min_inject == delta_wlrr_b ? "外国逆回购" : "国内逆回购"

string drain_str = max_drain > flow_threshold ? drain_name + "抽水(-" + str.tostring(max_drain, "#.##") + "B)" : "无明显抽水"
string inject_str = min_inject < -flow_threshold ? inject_name + "放水(+" + str.tostring(math.abs(min_inject), "#.##") + "B)" : "无明显放水"
string fed_flow_str = drain_str + " | " + inject_str

// 【逻辑修复】资金流颜色三态判定：明确抽水为红，明确放水为绿，若同时发生则按净力量对比，否则为白
bool is_core_draining = max_drain > flow_threshold and (max_drain == delta_tga_b or max_drain == delta_wlrr_b)
bool is_core_injecting = min_inject < -flow_threshold
color flow_text_color = (is_core_draining and is_core_injecting) ? (max_drain >= math.abs(min_inject) ? color.red : color.lime) : is_core_draining ? color.red : (is_core_injecting ? color.lime : color.white)

// === 5. 核心计算 (100% 保持 59 版原生单位换算) ===
total_liq = (fed_bal - tga_bal - rrp_bal + (ecb_bal_raw * eur_usd) + (pbc_bal_raw * cny_usd) + (boj_bal_raw * jpy_usd)) / 1000000000000
prev_liq = nz(total_liq[gli_mom_lookback], total_liq)
denom = math.max(math.abs(prev_liq), 0.01)

// 【逻辑修复】流动性冲量计算：引入 nz 强制过滤历史空值污染
total_liq_change = (total_liq - prev_liq) / denom * 100
liq_impulse = nz(total_liq_change) - nz(total_liq_change[gli_mom_lookback])

reserves_trillion = reserves_raw_display / 1000000000000
float gdp_aligned = gdp_raw > 1e11 ? gdp_raw : gdp_raw * 1000

reserve_to_gdp_ratio = wr_bal_raw_display / (gdp_aligned > 0 ? gdp_aligned : na)
reserve_to_assets_ratio = wr_bal_raw_display / (total_assets_display > 0 ? total_assets_display : na)
is_reserve_low_gdp = reserve_to_gdp_ratio < reserve_gdp_threshold and not na(reserve_to_gdp_ratio)
is_reserve_low_assets = reserve_to_assets_ratio < reserve_assets_threshold and not na(reserve_to_assets_ratio)
is_reserve_insufficient = is_reserve_low_gdp and is_reserve_low_assets

sofr = nz(request.security(src_sofr, "D", close, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off) * 100)
rrp_rate = nz(request.security(src_rrp, "D", close, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off) * 100)
effr = nz(request.security(src_effr, "D", close, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off) * 100)
iorb = nz(request.security(src_iorb, "D", close, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off) * 100)
us02y = nz(request.security(src_us02y, "D", close, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off) * 100)
us10y = nz(request.security(src_us10y, "D", close, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off) * 100) 
t10yie = nz(request.security(src_t10yie, "D", close, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off) * 100)
dfii10 = nz(request.security(src_dfii10, "D", close, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off) * 100)
credit_spread = nz(request.security(src_credit_spread, "D", close, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off) * 100)
us_inflation_rate = nz(request.security(src_usiryy, "D", close, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off) * 100)

// --- [优化模块] 收益率曲线斜率 (牛陡/熊陡) 监控 (危机捕获版) ---
yield_spread = us10y - us02y

smooth_us10y = ta.sma(us10y, 3)
smooth_us02y = ta.sma(us02y, 3)
smooth_spread = ta.sma(yield_spread, 3)

us10y_change = smooth_us10y - nz(smooth_us10y[curve_lookback], smooth_us10y)
us02y_change = smooth_us02y - nz(smooth_us02y[curve_lookback], smooth_us02y)
spread_change = smooth_spread - nz(smooth_spread[curve_lookback], smooth_spread)

bool curve_data_valid = not na(smooth_us10y[curve_lookback]) and not na(smooth_us02y[curve_lookback])

is_bull_steepener = curve_data_valid and (spread_change > spread_change_th) and (us02y_change <= -us02y_drop_th)
is_bear_steepener = curve_data_valid and (spread_change > spread_change_th) and (us10y_change >= us10y_spike_th)
var string curve_status_text = "平稳"
var color curve_status_color = color.gray

if is_bull_steepener
    curve_status_text := "牛陡(衰退前兆)"
    curve_status_color := color.red
else if is_bear_steepener
    curve_status_text := "熊陡(杀估值)"
    curve_status_color := color.orange
else if yield_spread < -50
    curve_status_text := "深度倒挂"
    curve_status_color := color.yellow
else if yield_spread < 0
    curve_status_text := "浅度倒挂"
    curve_status_color := color.gray
else
    curve_status_text := "平稳正斜率"
    curve_status_color := color.green
// -------------------------------------------------------------------------

credit_spread_roc = ta.roc(credit_spread, credit_roc_len)
is_credit_spiking = use_credit_roc and not na(credit_spread_roc) and (credit_spread_roc > credit_roc_th)
is_dxy_strong = not na(dxy_raw) and not na(dxy_ma) and (dxy_raw > dxy_ma)

s5th_ma5  = ta.sma(s5th_raw, 5)
s5th_ma20 = ta.sma(s5th_raw, 20)
s5th_ma50 = ta.sma(s5th_raw, 50)
is_s5th_weak = not na(s5th_raw) and s5th_raw < s5th_weak_th
is_s5th_death_cross = not na(s5th_ma5) and not na(s5th_ma20) and not na(s5th_ma50) and s5th_ma5 < s5th_ma20 and s5th_ma20 < s5th_ma50
is_s5th_weak_condition = use_s5th_alert and (is_s5th_weak and is_s5th_death_cross)
is_s5th_severe = use_s5th_alert and not na(s5th_raw) and s5th_raw < s5th_severe_th
is_s5th_overheat = use_s5th_alert and not na(s5th_raw) and s5th_raw >= s5th_overheat_th
is_s5th_bottom = use_s5th_alert and not na(s5th_raw) and s5th_raw <= s5th_bottom_th

gs_ratio_raw = (not na(silver_price) and silver_price != 0) ? gold_price / silver_price : na
gs_ratio     = nz(gs_ratio_raw, nz(gs_ratio_raw[1], na))
is_gs_low    = use_gsr_alert and not na(gs_ratio) and gs_ratio <= gsr_low_threshold
is_gs_high   = use_gsr_alert and not na(gs_ratio) and gs_ratio >= gsr_high_threshold

// 【V61 逻辑修正】美联储净流动性代理指标：TGA (财政部账户) 抽水为负向，准备金 (WRBWFRBL) 扩表为正向
lookback_norm = 500
wdtgal_min = ta.lowest(wdtgal, lookback_norm)
wdtgal_max = ta.highest(wdtgal, lookback_norm)
wrb_min = ta.lowest(wrbwfrbl, lookback_norm)
wrb_max = ta.highest(wrbwfrbl, lookback_norm)
norm_wdtgal = (wdtgal - wdtgal_min) / math.max(wdtgal_max - wdtgal_min, 1e-6)
norm_wrb = (wrbwfrbl - wrb_min) / math.max(wrb_max - wrb_min, 1e-6)
fed_liq_proxy = (1.0 - norm_wdtgal) * 0.5 + norm_wrb * 0.5
ma_fed_liq = ta.sma(fed_liq_proxy, ma_period)
fed_liq_top = fed_liq_proxy < ma_fed_liq and not na(ma_fed_liq)

gold_top_diff = effr - us_inflation_rate
is_gold_top = gold_top_diff < gold_th
is_impulse_waning = ta.falling(liq_impulse, 3)

// 100% 保持 59 版 RRP 单位换算 (/ 1e12)，但使用 raw_rrp_b 确保关闭 use_rrp 时不会误报 RRP 枯竭
rrp_trillion = nz(raw_rrp_b, 0) / 1000000000000
rrp_peak = ta.highest(rrp_trillion, 500)
rrp_pct = (rrp_trillion / (rrp_peak > 0 ? rrp_peak : 1)) * 100

// 【宏观纪元融合】结合 V56 的绝对值底线与 V57 的相对百分比
// 只要跌破历史峰值 5% (兼容 2.5T 现代巨量)，或者绝对值跌破 0.1T (兼容 2018、2008 旧时代)，均视为枯竭！
is_rrp_exhausted = (rrp_pct < 5.0) or (rrp_trillion < 0.1)

is_sudden_drain = total_liq_change < gli_mom_threshold
is_breakeven_positive = t10yie > us_inflation_rate

// (V57极速版：剔除ta.percentile动态黑洞周期，使用固定周期)
gli_high_th = ta.percentile_linear_interpolation(total_liq, gli_lookback, gli_high_pct)
