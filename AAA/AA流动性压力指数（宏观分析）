    string l3_breadth = is_s5th_bottom ? " 🟢【极端底部信号】标普500站上200日均线占比(S5TH=" + str.tostring(s5th_raw, "#.#") + "%)跌破" + str.tostring(s5th_bottom_th, "#.#") + "%历史冰点，恐慌盘彻底出清，中长线左侧赔率极佳！" : is_s5th_severe ? " 🩸【广度严重崩坏】S5TH广度跌至" + str.tostring(s5th_raw, "#.#") + "%(<" + str.tostring(s5th_severe_th, "#.#") + "%)，多数成分股跌破年线，指数内部处于空头主导，严控仓位、规避高波动题材！" : is_s5th_weak_condition ? " 📉【广度弱化+均线死叉】S5TH(" + str.tostring(s5th_raw, "#.#") + "%)呈现5/20/50日均线空头排列，市场赚钱效应收敛，宜去弱留强、向高安全边际价值股靠拢。" : is_s5th_overheat ? " 🔥【广度过热预警】S5TH高达" + str.tostring(s5th_raw, "#.#") + "%(≥" + str.tostring(s5th_overheat_th, "#.#") + "%)，市场情绪极度拥挤，谨防获利盘集中兑现引发的技术性回调。" : " 📈【广度健康】S5TH为" + str.tostring(s5th_raw, "#.#") + "%，微观交易结构稳健，可耐心持有具备业绩支撑的核心标的。"
    string ai_level_3_raw = "【三阶微观定价与风险溢价】" + l3_curve + l3_credit + l3_breadth
    
    string ai_level_1 = f_auto_wrap(ai_level_1_raw, 55)
    string ai_level_2 = f_auto_wrap(ai_level_2_raw, 55)
    string ai_flow    = f_auto_wrap(flow_analysis_raw, 55)
    string ai_level_3 = f_auto_wrap(ai_level_3_raw, 55)
    
    // 你去除了机器人的前缀，已保留此精简设计
    string ai_judgment = ai_flow + "\n\n" + ai_level_1 + "\n\n" + ai_level_2 + "\n\n" + ai_level_3
    
    table.cell(us_table, 0, 0, "LSI 压力", text_color=#ffffff, text_size=table_size, bgcolor=color.new(#333333, 50))
    table.cell(us_table, 1, 0, str.tostring(lsi, "#.##") + " BP", text_color=lsi >= threshold_extreme_tight ? color.maroon : lsi >= threshold_tight ? color.red : lsi < 0 ? color.green : #ffffff, text_size=table_size)
    table.cell(us_table, 2, 0, "GLI / 储备", text_color=#ffffff, text_size=table_size, bgcolor=color.new(#333333, 50))
    table.cell(us_table, 3, 0, str.tostring(total_liq, "#.##") + " / " + str.tostring(reserves_trillion, "#.##") + "T", text_color=is_gli_loose ? color.lime : is_gli_tight ? color.rgb(148, 147, 235, 9) : color.white, text_size=table_size)
    table.cell(us_table, 4, 0, "RRP 余额", text_color=#ffffff, text_size=table_size, bgcolor=color.new(#333333, 50))
    table.cell(us_table, 5, 0, str.tostring(rrp_trillion, "#.###") + "T (" + str.tostring(rrp_pct, "#.#") + "%)", text_color=is_rrp_exhausted ? color.red : color.lime, text_size=table_size)
    table.cell(us_table, 6, 0, "US02Y/利差", text_color=#ffffff, text_size=table_size, bgcolor=color.new(#333333, 50))
    table.cell(us_table, 7, 0, str.tostring(us02y_val, "#.##") + " / " + str.tostring(math.abs(us02y_val - effr_val), "#.##"), text_color = us02y_val > effr_val ? color.red : color.green, text_size = table_size)

