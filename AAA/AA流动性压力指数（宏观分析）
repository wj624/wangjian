    table.cell(us_table, 4, 1, "通胀预/实", text_color=#ffffff, text_size=table_size, bgcolor=color.new(#333333, 50))
    table.cell(us_table, 5, 1, str.tostring(t10yie_val, "#.##") + "% / " + str.tostring(real_rate_val, "#.##") + "%", text_color=(t10yie_val > th_t10yie or real_rate_val > th_real_tight ? color.red : color.white), text_size=table_size)
    table.cell(us_table, 6, 1, "信用/通胀", text_color=#ffffff, text_size=table_size, bgcolor=color.new(#333333, 50))
  
    table.cell(us_table, 7, 1, str.tostring(credit_val, "#.##") + "%" + credit_roc_str + " / " + str.tostring(inf_yoy_val, "#.##") + "%", text_color=(credit_val > (credit_th/100) or inf_yoy_val > th_inf_yoy or is_credit_spiking ? color.red : color.white), text_size=table_size)

    table.cell(us_table, 0, 2, "流动性冲量", text_color=#ffffff, text_size=table_size, bgcolor=color.new(#333333, 50))
    table.cell(us_table, 1, 2, str.tostring(liq_impulse, "#.##") + "%" + (is_impulse_waning ? " ⚠" : ""), text_color = liq_impulse > 0 ? color.lime : color.orange, text_size = table_size)
    table.cell(us_table, 2, 2, "S5TH 广度", text_color=#ffffff, text_size=table_size, bgcolor=color.new(#333333, 50))
    table.cell(us_table, 3, 2, str.tostring(s5th_raw, "#.#") + "%", text_color = is_s5th_severe ? color.red : is_s5th_weak_condition ? color.orange : color.white, text_size=table_size)
    table.cell(us_table, 4, 2, "资金去向(周)", text_color=#ffffff, text_size=table_size, bgcolor=color.new(#333333, 50))
    table.merge_cells(us_table, 5, 2, 7, 2)
    
    // 【UI 修复】挂载最新修复的 flow_text_color 变量
    table.cell(us_table, 5, 2, fed_flow_str, text_color=flow_text_color, text_size=table_size, text_halign=text.align_left)

    table.cell(us_table, 0, 3, "10Y-2Y利差", text_color=#ffffff, text_size=table_size, bgcolor=color.new(#333333, 50))
    table.cell(us_table, 1, 3, str.tostring(yield_spread, "#.##") + " BP", text_color=curve_status_color, text_size=table_size)
    table.cell(us_table, 2, 3, "曲线形态", text_color=#ffffff, text_size=table_size, bgcolor=color.new(#333333, 50))
    table.cell(us_table, 3, 3, curve_status_text, text_color=curve_status_color, text_size=table_size)
    table.cell(us_table, 4, 3, "斜率预警", text_color=#ffffff, text_size=table_size, bgcolor=color.new(#333333, 50))
    table.merge_cells(us_table, 5, 3, 7, 3)
    string steepener_warn = is_bull_steepener ? "衰退/流动性枯竭前兆" : is_bear_steepener ? "长端通胀/结构杀估值" : "暂无极端结构异动"
    table.cell(us_table, 5, 3, steepener_warn, text_color=curve_status_color, text_size=table_size, text_halign=text.align_left)

    table.merge_cells(us_table, 0, 4, 7, 4)
    table.cell(us_table, 0, 4, final_text, text_color = urgent_alert ? color.rgb(255, 140, 0) : color.white, text_size=table_size, text_halign=text.align_left, text_valign=text.align_center)
    
    table.merge_cells(us_table, 0, 5, 7, 5)
    table.cell(us_table, 0, 5, ai_judgment, text_color = color.rgb(190, 234, 255), text_size=table_size, text_halign=text.align_left, text_valign=text.align_center)
