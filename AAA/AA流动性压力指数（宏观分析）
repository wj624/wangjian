    else if liq_impulse > 0
        l2_pipes += "🟢冲量正向加速：流动性冲量(+" + str.tostring(liq_impulse, "#.##") + "%)处于正值扩张区间，边际资金推力良好。"
    string ai_level_2_raw = "【二阶流动性矩阵与底层水位】" + l2_base + l2_pipes

    // 3. 三阶微观定价与风险溢价（美债曲线结构 + 信用利差高度与动量 + S5TH 市场广度与抄底/过热）
    string l3_curve = is_bull_steepener ? "🚨【牛陡/衰退预警】短端2Y美债周期内暴跌(" + str.tostring(us02y_change, "#.#") + "BP)，10Y-2Y利差迅速走阔(+" + str.tostring(spread_change, "#.#") + "BP)，市场正恐慌性抢跑美联储紧急降息与经济硬着陆，立即转向现金与短债防御！" : is_bear_steepener ? "🚨【熊陡/杀估值警报】长端10Y美债失控飙升(+" + str.tostring(us10y_change, "#.#") + "BP)，期限溢价爆表，高估值科技股与长久期资产面临折现率上行带来的惨烈杀估值！" : yield_spread < -50 ? "⚠️【深度倒挂】10Y-2Y利差深度倒挂(" + str.tostring(yield_spread, "#.#") + "BP)，隐含中长期衰退引力，切忌在周期顶部过度加杠杆；" : yield_spread < 0 ? "🟡【浅度倒挂】10Y-2Y利差处于" + str.tostring(yield_spread, "#.#") + "BP浅度倒挂区间，观察向正斜率修复的路径(牛陡或熊陡)；" : "🟢【正斜率】10Y-2Y利差为+" + str.tostring(yield_spread, "#.#") + "BP平稳正斜率，期限结构常态化；"
